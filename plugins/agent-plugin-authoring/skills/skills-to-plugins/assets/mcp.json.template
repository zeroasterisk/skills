{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "server-name": {
      "type": "stdio",
      "command": "./bin/server-binary",
      "args": ["--config", "${PLUGIN_ROOT}/config.json"],
      "env": {
        "DATA_DIR": "${PLUGIN_DATA}/storage"
      },
      "cwd": "${PLUGIN_ROOT}"
    },
    "remote-server": {
      "type": "streamable-http",
      "url": "https://mcp.example.com/mcp",
      "headers": {
        "X-Tenant": "default"
      }
    }
  }
}
