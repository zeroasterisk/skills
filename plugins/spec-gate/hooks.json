{
  "spec-gate": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node ./adapters/antigravity/hook.mjs session-start",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content|write_file|edit_file|sed_file|notebook_edit|create_file|file_write",
        "hooks": [
          {
            "type": "command",
            "command": "node ./adapters/antigravity/hook.mjs pre-tool",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
